# ---------------------------------------------------------------------------
# ResumeIQ configuration. Copy to `.env` and edit. Never commit a real .env.
# ---------------------------------------------------------------------------

# --- Service -------------------------------------------------------------
RESUMEIQ_ENV=development            # development | staging | production
RESUMEIQ_LOG_LEVEL=INFO
RESUMEIQ_LOG_FORMAT=json            # json | console
RESUMEIQ_HOST=0.0.0.0
RESUMEIQ_PORT=8000
RESUMEIQ_CORS_ORIGINS=http://localhost:8501

# --- Storage -------------------------------------------------------------
RESUMEIQ_DATABASE_URL=sqlite:///./data/resumeiq.db

# --- Uploads -------------------------------------------------------------
RESUMEIQ_MAX_UPLOAD_BYTES=5242880   # 5 MiB
RESUMEIQ_MAX_RESUME_CHARS=60000

# --- LLM layer (optional) ------------------------------------------------
# Without a key the service still returns full deterministic analysis;
# only the narrative coaching layer is disabled.
ANTHROPIC_API_KEY=
RESUMEIQ_LLM_ENABLED=true
RESUMEIQ_LLM_MODEL=claude-opus-5
RESUMEIQ_LLM_MAX_TOKENS=8000
RESUMEIQ_LLM_EFFORT=medium          # low | medium | high | xhigh | max
RESUMEIQ_LLM_TIMEOUT_SECONDS=60
RESUMEIQ_LLM_MAX_RETRIES=2
RESUMEIQ_LLM_REDACT_PII=true

# --- Rate limiting -------------------------------------------------------
RESUMEIQ_RATE_LIMIT_REQUESTS=60
RESUMEIQ_RATE_LIMIT_WINDOW_SECONDS=60
